generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Usuario do sistema (autenticacao do dashboard/app)
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  devices      Device[]
}

/// Um dispositivo ESP32 cadastrado, identificado por uma api key propria
/// (nao usa o login de usuario - autenticacao separada para ingestao).
/// Pertence a um usuario (dono do device).
model Device {
  id         String          @id @default(uuid())
  name       String
  hardwareId String?         @unique
  apiKey     String          @unique
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  readings   SensorReading[]

  @@index([userId])
}

/// Tipos de sensor suportados. So SOIL_HUMIDITY esta em uso hoje;
/// os demais ja ficam prontos para quando novos sensores forem integrados.
enum SensorType {
  SOIL_HUMIDITY
  TEMPERATURE
  WATER_LEVEL
  LUMINOSITY
}

/// Cada leitura enviada por um device. Estrutura generica (type + value)
/// para nao precisar de migration nova a cada sensor novo.
/// sensorLabel e opcional - so usado quando o device tem mais de um sensor
/// do mesmo type (ex: dois sensores de umidade do solo na mesma placa).
model SensorReading {
  id          String     @id @default(uuid())
  deviceId    String
  device      Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type        SensorType
  sensorLabel String?
  value       Float
  createdAt   DateTime   @default(now())

  @@index([deviceId, type, sensorLabel, createdAt])
}
